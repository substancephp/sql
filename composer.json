{
    "name": "substancephp/sql",
    "description": "A simple SQL query builder for PHP",
    "type": "library",
    "license": "MIT",
    "autoload": {
        "psr-4": {
          "SubstancePHP\\SQL\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Test\\": "test",
            "TestUtil\\": "testutil"
        }
    },
    "require": {
        "php": ">=8.4",
        "ext-pdo": "*"
    },
    "require-dev": {
        "ext-xdebug": "*",
        "ext-sqlite3": "*",
        "phpunit/phpunit": "^11.0",
        "phpstan/phpstan": "^2.1",
        "friendsofphp/php-cs-fixer": "^3.95"
    },
    "minimum-stability": "stable",
    "scripts": {
        "qa": ["@lint", "@stan", "@test"],
        "lint": "vendor/bin/php-cs-fixer check",
        "delint": "vendor/bin/php-cs-fixer fix",
        "stan": "vendor/bin/phpstan analyse --level=8 --memory-limit=1G src test testutil",
        "test": "XDEBUG_MODE=coverage vendor/bin/phpunit --coverage-text test",
        "serve-coverage-report": "php -S localhost:3000 -t html-coverage"
    },
    "scripts-descriptions": {
      "qa": "Run all the code quality checks; don't auto-fix anything",
      "lint": "Check for lint",
      "delint": "De-lint",
      "stan": "Run static analysis",
      "test": "Run the tests",
      "serve-coverage-report": "Serve an HTML code coverage report"
    },
    "support": {
        "issues": "https://github.com/substancephp/sql/issues",
        "source": "https://github.com/substancephp/sql"
    }
}
